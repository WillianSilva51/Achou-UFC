RewriteEngine On

# Bloqueia pastas internas: código-fonte, dependências, docs, seeds do banco, git, IDE
RewriteRule ^(src|vendor|docs|docker|\.git|\.idea|\.venv)(/|$) - [F,L]

# Bloqueia arquivos de configuração/metadados sensíveis
RewriteRule ^(composer\.(json|lock)|Dockerfile|docker-compose\.yml|README\.md|LICENSE|\.env(\.example)?|\.gitignore|\.php-cs-fixer.*)$ - [F,L]

# Só /api passa pelo front controller
RewriteRule ^api(/.*)?$ public/index.php [QSA,L]

Options -Indexes -MultiViews +FollowSymLinks

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>