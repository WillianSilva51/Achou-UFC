<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always unset X-Powered-By
  Header unset Server
  Header always unset Server
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On

# Bloqueia pastas internas do backend e libera assets públicos em src/js e src/components
RewriteRule ^src/?$ - [F,L]
RewriteRule ^src/(Controllers|Core|Entity|Middlewares|Models)(/|$) - [F,L]
RewriteRule ^(vendor|docs|docker|\.git|\.idea|\.venv)(/|$) - [F,L]

# Bloqueia arquivos de configuração/metadados sensíveis
RewriteRule ^(composer\.(json|lock)|Dockerfile|Caddyfile|docker-compose.*\.ya?ml|README\.md|LICENSE|\.env(\.example)?|\.gitignore|\.dockerignore|\.php-cs-fixer.*)$ - [F,L]
RewriteRule \.(bak|backup|dist|ini|log|sql|zip)$ - [F,L]

# Só /api passa pelo front controller
RewriteRule ^api(/.*)?$ public/index.php [QSA,L]

Options -Indexes -MultiViews +FollowSymLinks

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>
